/*--------------------------------*- C++ -*----------------------------------*\
| Axisymmetric (wedge) 3dTube, generated by tube_axi/make_case.py             |
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    outlet
    {
        type        fixedValue;
        value       uniform 0;
    }
    inlet
    {
        type          uniformFixedValue;
        uniformValue  tableFile;
        "file|fileName"     "$FOAM_CASE/0/fluid/time-series";
        outOfBounds         clamp;
    }
    wall
    {
        type        elasticWallPressure;
        value       uniform 0;
    }
    "front|back"
    {
        type        wedge;
    }
    axis
    {
        type        empty;
    }
}

