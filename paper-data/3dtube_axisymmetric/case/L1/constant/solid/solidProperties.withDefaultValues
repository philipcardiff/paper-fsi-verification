FoamFile
{
    version     2.0;
    format      binary;
    arch        "LSB;label=32;scalar=64";
    class       dictionary;
    location    "constant/solid";
    object      solidProperties.withDefaultValues;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solidModel      linearGeometryTotalDisplacement;

"linearGeometryCoeffs|linearGeometryTotalDisplacementCoeffs|nonLinearGeometryUpdatedLagrangianCoeffs"
{
    solutionAlgorithm PETScSNES;
    nCorrectors     20000;
    solutionTolerance 1e-09;
    alternativeTolerance 1e-09;
    infoFrequency   100;
    predictor       on;
    stopOnPetscError false;
    dampingCoeff    dampingCoeff [ 0 0 -1 0 0 0 0 ] 0;
    writeResidualField false;
    relaxationMethod fixed;
    restart         false;
    residualFile    false;
    stabilisation
    {
        momentum
        {
            type            diffStencilLaplacian;
            scaleFactor     0.1;
        }
        pressure
        {
            type            diffStencilLaplacian;
            scaleFactor     0.1;
        }
    }
}


