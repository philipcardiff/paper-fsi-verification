FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}

application     pimpleFoam;
startFrom       latestTime;
startTime       0;
stopAt          endTime;
endTime         30;
deltaT          0.025;      // set per level by setup-case.py
writeControl    adjustableRunTime;
writeInterval   2;
purgeWrite      0;
writeFormat     ascii;
writePrecision  12;
writeCompression off;
timeFormat      general;
timePrecision   8;
runTimeModifiable false;
adjustTimeStep  no;

libs ("libpreciceAdapterFunctionObject.so");

functions
{
    // Drag and lift on cylinder + plate; divided by the 0.015 m depth in post-processing
    forces
    {
        type            forces;
        libs            (forces);
        writeControl    timeStep;
        writeInterval   1;
        patches         (plate cylinder);
        p               p;
        U               U;
        rho             rhoInf;
        rhoInf          1000;
        CofR            (0.2 0.2 0);
        log             false;
    }

    preCICE_Adapter
    {
        type            preciceAdapterFunctionObject;
        errors          strict;
        enabled         true;   // switched off for the uncoupled 0-2 s ramp
    }
}
