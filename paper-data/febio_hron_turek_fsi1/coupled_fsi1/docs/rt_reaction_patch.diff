+// Experimental reaction transfer (default OFF): see FEFluidFSIDomain3D::UnpackLMReaction
+static bool rt_reaction_enabled()
+{
+    static int v = -1;
+    if (v < 0) { const char* e = getenv("FEBIO_RT_REACTION"); v = (e && atoi(e) != 0) ? 1 : 0; }
+    return v == 1;
+}
+
+void FEFluidFSIDomain3D::UnpackLMReaction(FEElement& el, vector<int>& lmr)
+{
+    UnpackLM(el, lmr);
+    if (!rt_reaction_enabled()) return;
+    int N = el.Nodes();
+    for (int i=0; i<N; ++i)
+    {
+        FENode& node = m_pMesh->Node(el.m_node[i]);
+        vector<int>& id = node.m_ID;
+        for (int k=0; k<3; ++k)
+        {
+            // w fixed (no equation) and displacement free: the fluid momentum residual of this node acts on the solid
+            if ((lmr[7*i+3+k] < 0) && (lmr[7*i+k] >= 0)) lmr[7*i+3+k] = lmr[7*i+k];
+        }
+    }
+}
