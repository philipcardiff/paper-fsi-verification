<febio_spec version="4.0">
	<Module type="solid"/>
	<Control><analysis>STATIC</analysis><time_steps>40</time_steps><step_size>0.05</step_size><solver type="solid"><symmetric_stiffness>symmetric</symmetric_stiffness><max_refs>25</max_refs><dtol>1e-10</dtol><etol>1e-20</etol><rtol>0</rtol><lstol>0.9</lstol><min_residual>1e-30</min_residual><qn_method type="full Newton"/></solver></Control>
	<Material><material id="1" name="Ring" type="Mooney-Rivlin"><density>1000</density><c1>3846.15384615385</c1><c2>0</c2><k>16666.6666666667</k><pressure_model>NIKE3D</pressure_model></material></Material>
	<Mesh><Nodes name="N">
