	<MeshDomains><SolidDomain name="Ring" mat="Ring"/></MeshDomains><Boundary>
		<bc name="ux" node_set="All" type="prescribed displacement"><dof>x</dof><value type="math">SSS=exp(-1/min(max(t,0.005),0.995))/(exp(-1/min(max(t,0.005),0.995))+exp(-1/(1-min(max(t,0.005),0.995))));AAA=0.5*SSS*sin(3*t);(cos(AAA)-1)*X-sin(AAA)*Y</value><relative>0</relative></bc>
		<bc name="uy" node_set="All" type="prescribed displacement"><dof>y</dof><value type="math">SSS=exp(-1/min(max(t,0.005),0.995))/(exp(-1/min(max(t,0.005),0.995))+exp(-1/(1-min(max(t,0.005),0.995))));AAA=0.5*SSS*sin(3*t);sin(AAA)*X+(cos(AAA)-1)*Y</value><relative>0</relative></bc>
		<bc name="uz" node_set="All" type="zero displacement"><x_dof>0</x_dof><y_dof>0</y_dof><z_dof>1</z_dof></bc>
