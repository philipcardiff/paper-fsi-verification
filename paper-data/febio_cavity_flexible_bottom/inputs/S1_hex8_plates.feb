	<Module type="solid"/>
	<Control><analysis>STATIC</analysis><time_steps>20</time_steps><step_size>0.05</step_size><plot_zero_state>0</plot_zero_state><plot_range>0,-1</plot_range><plot_level>PLOT_MAJOR_ITRS</plot_level><output_level>OUTPUT_MAJOR_ITRS</output_level>
