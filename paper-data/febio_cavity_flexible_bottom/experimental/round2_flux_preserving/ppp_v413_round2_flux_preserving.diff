diff -ruN '--exclude=.git' upstream/febio-v4.13/FEBioFluid/FEFluidPPP.cpp src_experimental/febio-v4.13-ppp/FEBioFluid/FEFluidPPP.cpp
--- upstream/febio-v4.13/FEBioFluid/FEFluidPPP.cpp	1970-01-01 01:00:00.000000000 +0100
+++ src_experimental/febio-v4.13-ppp/FEBioFluid/FEFluidPPP.cpp	2026-10-30 21:40:28.587846979 +0000
@@ -0,0 +1,71 @@
+// EXPERIMENTAL (febio-v4.13-ppp): see FEFluidPPP.h
+#include "FEFluidPPP.h"
+#include <cstdlib>
+#include <vector>
+namespace febio_ppp {
+double Alpha() { static const double a = getenv("FEBIO_PPP_ALPHA") ? atof(getenv("FEBIO_PPP_ALPHA")) : 0.0; return a; }
+bool RimOnce() { static const bool r = getenv("FEBIO_PPP_RIM_ONCE") && atoi(getenv("FEBIO_PPP_RIM_ONCE")) != 0; return r || Alpha() != 0.0; }
+bool FirstUse() { static bool first = true; bool r = first; first = false; return r; }
+
+// apply the redistribution map to the nodal vector s (length neln) in place
+static void redistribute(int neln, const int* con, double* s)
+{
+    if (!con) return;
+    int nF = 0; double C = 0; for (int a = 0; a < neln; ++a) { if (con[a]) C += s[a]; else ++nF; }
+    for (int a = 0; a < neln; ++a) { if (con[a]) s[a] = 0.0; else if (nF) s[a] += C/nF; }
+    if (nF == 0) for (int a = 0; a < neln; ++a) s[a] = 0.0;
+}
+static bool anyCon(int neln, const int* con) { if (!con) return false; for (int a = 0; a < neln; ++a) if (con[a]) return true; return false; }
+
+static void sums(int nq, int neln, const double* W, const double* H, const double* p, double& V, double& pbar, std::vector<double>& I)
+{
+    V = 0; double s = 0; I.assign(neln, 0.0);
+    for (int q = 0; q < nq; ++q) { V += W[q]; s += W[q]*p[q]; for (int a = 0; a < neln; ++a) I[a] += W[q]*H[q*neln+a]; }
+    pbar = s/V;
+}
+
+void Residual(double alpha, double mu, int nq, int neln, const double* W, const double* H, const double* p, double* fJ, const int* con)
+{
+    if (alpha == 0.0 || mu <= 0.0) return;
+    double V, pbar; std::vector<double> I; sums(nq, neln, W, H, p, V, pbar, I);
+    const double g = -alpha/mu;
+    std::vector<double> S(neln);
+    for (int a = 0; a < neln; ++a) { double s = 0; for (int q = 0; q < nq; ++q) s += W[q]*H[q*neln+a]*(p[q]-pbar); S[a] = g*s; }
+    redistribute(neln, con, S.data());
+    for (int a = 0; a < neln; ++a) fJ[a] += S[a];
+}
+
+void TangentE(double alpha, double mu, double alphaf, int nq, int neln, const double* W, const double* H, const double* dp, const double* p, double* kee, const int* con)
+{
+    if (alpha == 0.0 || mu <= 0.0) return;
+    double V, pbar; std::vector<double> I; sums(nq, neln, W, H, p, V, pbar, I);
+    const double g = -alpha/mu*alphaf;
+    std::vector<double> K(neln*neln, 0.0);
+    std::vector<double> J(neln, 0.0); // J_b = sum_q W_q dp_q H_qb
+    for (int q = 0; q < nq; ++q) for (int b = 0; b < neln; ++b) J[b] += W[q]*dp[q]*H[q*neln+b];
+    for (int a = 0; a < neln; ++a) for (int b = 0; b < neln; ++b) {
+        double s = 0; for (int q = 0; q < nq; ++q) s += W[q]*H[q*neln+a]*dp[q]*H[q*neln+b];
+        K[a*neln+b] = g*(s - I[a]*J[b]/V);
+    }
+    // rows of K go through the (constant) redistribution map, column by column
+    std::vector<double> col(neln);
+    for (int b = 0; b < neln; ++b) { for (int a = 0; a < neln; ++a) col[a] = K[a*neln+b]; redistribute(neln, con, col.data()); for (int a = 0; a < neln; ++a) kee[a*neln+b] += col[a]; }
+}
+
+void TangentX(double alpha, double mu, double alphaf, int nq, int neln, const double* W, const double* H, const double* gradN, const double* p, double* kxu, const int* con)
+{
+    if (alpha == 0.0 || mu <= 0.0) return;
+    double V, pbar; std::vector<double> I; sums(nq, neln, W, H, p, V, pbar, I);
+    const double g = -alpha/mu*alphaf;
+    for (int b = 0; b < neln; ++b) for (int k = 0; k < 3; ++k) {
+        double gb = 0; for (int q = 0; q < nq; ++q) gb += W[q]*gradN[(q*neln+b)*3+k]*(p[q]-pbar); gb /= V;
+        std::vector<double> col(neln);
+        for (int a = 0; a < neln; ++a) {
+            double s = 0; for (int q = 0; q < nq; ++q) s += W[q]*gradN[(q*neln+b)*3+k]*H[q*neln+a]*(p[q]-pbar);
+            col[a] = g*(s - I[a]*gb);
+        }
+        redistribute(neln, con, col.data());
+        for (int a = 0; a < neln; ++a) kxu[(a*neln+b)*3+k] += col[a];
+    }
+}
+}
diff -ruN '--exclude=.git' upstream/febio-v4.13/FEBioFluid/FEFluidPPP.h src_experimental/febio-v4.13-ppp/FEBioFluid/FEFluidPPP.h
--- upstream/febio-v4.13/FEBioFluid/FEFluidPPP.h	1970-01-01 01:00:00.000000000 +0100
+++ src_experimental/febio-v4.13-ppp/FEBioFluid/FEFluidPPP.h	2026-10-30 21:40:28.587846979 +0000
@@ -0,0 +1,24 @@
+// EXPERIMENTAL (febio-v4.13-ppp): local polynomial pressure projection (Dohrmann-Bochev) for the continuity row of the
+// fluid dilatation formulation. See FEBIO_PRESSURE_PROJECTION_DERIVATION.md. Pure functions on element arrays (no FEBio types),
+// so that they can be tested against finite differences outside the solver.
+//   S_i = -(alpha/mu) sum_q W_q N_i(q) (p_q - pbar),   pbar = sum_q W_q p_q / V,   V = sum_q W_q
+// Arrays: W[nq] (quadrature weight x detJ, NOT times alphaf), H[q*neln+a] shape functions, p[nq] pressures, dp[nq] = dp/de.
+#pragma once
+namespace febio_ppp {
+// alpha from env FEBIO_PPP_ALPHA (default 0 = stock behaviour; read once)
+double Alpha();
+// returns true once per process (used to print the log banner)
+bool FirstUse();
+// RimOnce(): true if the rim pressure is to be re-evaluated once per time step (alpha > 0, or env FEBIO_PPP_RIM_ONCE=1 for the separating control)
+bool RimOnce();
+// Conservation-consistent version (round 2): 'con' (may be nullptr = round-1 behaviour) flags nodes whose e_f is constrained (prescribed/fixed): 1 = constrained.
+// Stabilisation rows of constrained nodes are removed and their sum is added back, with equal weights, to the free rows of the element:
+//   S~_i = S_i + (1/nF) sum_{c in C} S_c  (i free),  S~_c = 0  =>  sum over the element's free rows = 0 exactly (also sum over all rows = 0).
+// If every node is constrained the element contributes nothing. The map is linear and constant (independent of e and x), so tangents use the same map on their rows.
+// fJ[a] += S~_a
+void Residual(double alpha, double mu, int nq, int neln, const double* W, const double* H, const double* p, double* fJ, const int* con = nullptr);
+// kee[a*neln+b] += d S_a / d e_b (includes the factor alphaf of the alphaf-interpolated state)
+void TangentE(double alpha, double mu, double alphaf, int nq, int neln, const double* W, const double* H, const double* dp, const double* p, double* kee, const int* con = nullptr);
+// kxu[(a*neln+b)*3+k] += d S_a / d x_b,k  (FSI domain: dependence on the current-configuration quadrature weights); gradN[(q*neln+b)*3+k] spatial
+void TangentX(double alpha, double mu, double alphaf, int nq, int neln, const double* W, const double* H, const double* gradN, const double* p, double* kxu, const int* con = nullptr);
+}
