+def writeExactOldTime(prefix):
+    """Old-time solid displacements D_0, D_0_0, D_0_0_0 at t = -dt, -2dt, -3dt
+    from the exact solution (smooth continuation to t < 0), at the cell centres
+    and boundary face centres of the uniform solid reference mesh."""
+    import subprocess
+    exe = os.path.join(os.path.dirname(os.path.abspath(__file__)),
+                       "evalExactFlat" if a.variant == "flat" else "evalExact")
+    dx, dy = 2.0/nx, 0.5/nys
+    cells = [((i + 0.5)*dx, 1 + (j + 0.5)*dy) for j in range(nys) for i in range(nx)]
+    faces = {"interface": [((i + 0.5)*dx, 1.0) for i in range(nx)],
+             "top": [((i + 0.5)*dx, 1.5) for i in range(nx)],
+             "left": [(0.0, 1 + (j + 0.5)*dy) for j in range(nys)],
+             "right": [(2.0, 1 + (j + 0.5)*dy) for j in range(nys)]}
+    def ev(pts, t):
+        inp = "".join(f"solid {X:.17g} {Y:.17g} {t:.17g}\n" for X, Y in pts)
+        out = subprocess.run([exe], input=inp, capture_output=True, text=True, check=True).stdout
+        return [tuple(map(float, l.split()[:2])) for l in out.strip().splitlines()]
+    def lst(v):
+        return "nonuniform List<vector> %d\n(\n%s\n)" % (len(v), "\n".join(f"({d[0]:.15g} {d[1]:.15g} 0)" for d in v))
+    for k, name in ((1, "D_0"), (2, "D_0_0"), (3, "D_0_0_0")):
+        t = -k*a.dt
+        body = "dimensions [0 1 0 0 0 0 0];\ninternalField %s;\nboundaryField\n{\n" % lst(ev(cells, t))
+        for pn, pts in faces.items():
+            body += "    %s\n    {\n        type calculated;\n        value %s;\n    }\n" % (pn, lst(ev(pts, t)))
+        body += "    frontAndBack { type empty; }\n}\n"
+        w(prefix + name, body, "volVectorField", name)
 
